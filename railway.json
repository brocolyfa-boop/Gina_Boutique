{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --include=dev && npm run build -w @gina/shared && npm run build -w @gina/api",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm start -w @gina/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
