# Postgres — Railway la genera sola al agregar el plugin. Cópiala del dashboard.
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Secretos JWT — genera cada uno con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# PixelPay (https://pixelpay.app) — empezar en sandbox
PIXELPAY_API_KEY=
PIXELPAY_API_SECRET=
PIXELPAY_MODE=sandbox

# Cloudinary para imágenes de producto (opcional en desarrollo)
CLOUDINARY_URL=

PORT=3000

# Tarifas de envío en lempiras, según lo que cobra la mensajería. Viven aquí y
# no en el frontend para poder cambiarlas sin republicar la app de Android.
COSTO_ENVIO_TEGUCIGALPA_LPS=90
COSTO_ENVIO_NACIONAL_LPS=120
# Respaldo por compatibilidad: se usa si falta alguna de las dos de arriba.
COSTO_ENVIO_LPS=120

# Orígenes permitidos por CORS, separados por coma. Incluir las variantes con
# 127.0.0.1: para CORS no son el mismo origen que localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# --------------------------- Aviso de pedido nuevo ---------------------------
# Todo opcional. Sin nada configurado, el resumen del pedido sale por consola y
# queda en los logs del servicio; funciona, pero hay que ir a buscarlo.

# WhatsApp Cloud API de Meta (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# A quién se le avisa, con código de país y sin signos.
WHATSAPP_DESTINO=50499998888

# Correo por Resend (https://resend.com), como alternativa o además.
RESEND_API_KEY=
NOTIFICAR_EMAIL=
NOTIFICAR_EMAIL_DESDE=Gina Boutique <onboarding@resend.dev>

# Número público de la tienda: el del botón flotante de WhatsApp de la web y el
# del enlace "enviar mi pedido" en la confirmación. Admite 9999-8888.
TIENDA_WHATSAPP=
